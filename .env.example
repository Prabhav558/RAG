# Copy to .env and fill in as needed. Nothing here is required for local dev — every setting has a working
# default (see README.md "Run it") — except ANTHROPIC_API_KEY, which is only needed for the LLM judge and the
# ODTQRC clarity agent.
#
# `docker compose up` reads this file automatically. Running the backend directly (uvicorn/pytest) does not —
# the app reads plain os.environ, so either `export $(grep -v '^#' .env | xargs)` first, or export the specific
# variables you need.

# ---- database ----
# SQLite by default (a local file, created automatically). Point this at Postgres for a shared deployment.
SCORECARD_DB_URL=sqlite:///./scorecard.db
# SCORECARD_DB_URL=postgresql+psycopg://user:password@localhost:5432/scorecard

# In production (behind Alembic migrations), set this to 0 so the app doesn't create tables itself on start.
SCORECARD_AUTO_CREATE=1

# Used only by `docker compose up` (docker-compose.yml), for the Postgres container it manages.
POSTGRES_PASSWORD=change-me

# ---- LLM judge & clarity agent (optional) ----
# Needed only to use "LLM judge" on an evaluation or "Check clarity" on a subject's task definition. Without it,
# both features return a clean "not configured" error and everything else works normally.
ANTHROPIC_API_KEY=

# Anthropic model used by each. Defaults shown; override only if you want a different model.
SCORECARD_JUDGE_MODEL=claude-opus-5
SCORECARD_CLARITY_MODEL=claude-opus-5

# ---- authentication (Phase 2: docs/14_PHASE2_SECURITY_SPEC.md) ----
# How long a login session lasts, and how long an account locks after 5 failed logins.
SESSION_TTL_DAYS=14
LOGIN_LOCKOUT_MINUTES=15

# ---- red diagnosis (docs/10_CYCLE3_BEHAVIOUR_SPEC.md) ----
# A person is flagged as needing a diagnosis after this many "redo" decisions within the window.
RED_THRESHOLD=3
RED_WINDOW_DAYS=90

# ---- data retention (data/tools/retention.py) ----
# How old audit events and void evaluations must be before `retention.py --apply` purges them.
AUDIT_RETENTION_DAYS=400
VOID_RETENTION_DAYS=90

# ---- advanced / rarely needed ----
# Autogenerate an Alembic migration against a historical copy of the models (e.g. the Cycle 2 baseline) instead
# of the current app.models. Maintainers only.
# ALEMBIC_TARGET_PACKAGE=app
